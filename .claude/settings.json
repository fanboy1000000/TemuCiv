{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/model-routing-guard.mjs",
            "timeout": 10,
            "statusMessage": "Checking model routing (reviewer on Fable; generic spawns name a model)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/sprint-close-guard.mjs",
            "timeout": 30,
            "statusMessage": "Checking that the git hooks stay switched on"
          }
        ]
      }
    ]
  }
}
